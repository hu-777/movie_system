<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SeatMapper">
    
    <select id="selectByScreeningId" resultType="com.example.entity.Seat">
        select * from seat where screening_id = #{screeningId}
    </select>

    <select id="selectById" resultType="com.example.entity.Seat">
        select * from seat where id = #{id}
    </select>
    
    <update id="updateSeatStatus">
        update seat set status = #{status} where id = #{id}
    </update>
    
    <update id="batchUpdateSeatStatus">
        update seat set status = #{status} where id in
        <foreach collection="seatIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>
    
    <!-- 添加插入座位的SQL -->
    <insert id="insert" parameterType="com.example.entity.Seat">
        insert into seat (screening_id, seat_row, seat_column, seat_name, status)
        values (#{screeningId}, #{seatRow}, #{seatColumn}, #{seatName}, #{status})
    </insert>
</mapper>